NODE_ENV=development
PORT=5000
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters-long
REFRESH_TOKEN_SECRET=replace-with-a-different-random-secret-at-least-32-characters-long
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jalsevadb"

# Frontend / deep-link base URL used to build the activation URL in invitation emails.
# For Expo dev (mobile deep link):  FRONTEND_URL=jalseva://
# For web-based activation:         FRONTEND_URL=http://localhost:3000
FRONTEND_URL=jalseva://

# ── Nodemailer / SMTP configuration ──────────────────────────────────────────
# Gmail (with App Password, not your account password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your-email@gmail.com
#   SMTP_PASS=your-16-char-app-password
#
# Outlook / Office 365:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#
# For local development without a real SMTP server, use Ethereal (free):
#   1. Visit https://ethereal.email/ and create a free account.
#   2. Copy the credentials below.
#   SMTP_HOST=smtp.ethereal.email
#   SMTP_PORT=587
#   SMTP_USER=generated-user@ethereal.email
#   SMTP_PASS=generated-password
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-email@example.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM=Jal Seva <noreply@jalseva.gov.in>
